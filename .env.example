# Discord webhook URL for alerts (Server Settings -> Integrations -> Webhooks).
# Leave empty (or use --dry-run) to print alerts instead of posting.
DISCORD_WEBHOOK_URL=

# Optional: comma-separated proxies, e.g.
# PROXIES=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
# A single rotating endpoint from your provider also works — just put the one URL.
PROXIES=

# Seconds between full poll passes (jitter added automatically).
POLL_INTERVAL_SEC=60

# Seconds before re-alerting on the same product+event (anti-spam).
ALERT_COOLDOWN_SEC=1800
